# ── Server ─────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Public URL of the site (used for canonical URLs, sitemap, reset links)
SITE_URL=https://www.digitalguru.in
TIMEZONE=Asia/Kolkata
# Set to 1 when running behind a reverse proxy / load balancer (Nginx, Render, Railway…)
TRUST_PROXY=1

# ── Database ───────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/digital_guru

# ── Auth ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-64-char-random-string
SESSION_HOURS=12

# ── First admin (used by `npm run seed` / `npm run create-admin`) ──
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@digitalguru.in
ADMIN_PASSWORD=ChangeMe@123

# ── Business contact (shown on the website) ────────────
BUSINESS_PHONE=+919876543210
BUSINESS_PHONE_DISPLAY=+91 98765 43210
WHATSAPP_NUMBER=919876543210
BUSINESS_EMAIL=hello@digitalguru.in
BUSINESS_ADDRESS=Navi Mumbai, Maharashtra, India
BUSINESS_CITY=Navi Mumbai
BUSINESS_REGION=Maharashtra
BUSINESS_POSTCODE=400703

# ── Email (optional; needed for password-reset emails & new-lead alerts) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Digital Guru <no-reply@digitalguru.in>"
# Comma-separated list of addresses that get an email for every new lead
NEW_LEAD_NOTIFY=

# ── Anti-spam (optional; Cloudflare Turnstile) ─────────
# Leave empty to rely on honeypot + timing + rate limiting only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics (optional) ───────────────────────────────
GA4_ID=
GOOGLE_SITE_VERIFICATION=

# ── Browser push notifications (optional) ──────────────
# Leave empty: keys are generated automatically on first run and stored in the DB.
# To set your own: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@digitalguru.in

# ── Meta Lead Ads (optional) ───────────────────────────
# Put REAL values only in Render → Environment (or your local .env, which git ignores).
# META_PAGE_ACCESS_TOKEN: Business System User token (expiry "Never") with leads_retrieval,
# pages_show_list, pages_read_engagement, pages_manage_metadata, pages_manage_ads, ads_management.
# It is the only place the token is read from — it cannot be entered in the CRM.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# App secret of the SAME Meta app the system user token was generated for (webhook signatures + appsecret_proof)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
# Minutes between automatic pulls of new Meta leads (0 = webhook only)
META_SYNC_MINUTES=5
# After an auth error (expired/invalid token, missing permission) auto-sync pauses and re-checks
# after 15 min, then 30, 60 … up to 6 h. A redeploy with a new token resumes immediately.
# META_AUTH_RETRY_MINUTES=15
