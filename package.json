{
  "name": "digital-guru",
  "version": "1.0.0",
  "private": true,
  "description": "Digital Guru — agency website + lead management CRM (Node.js, Express, MongoDB)",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm --prefix admin install && npm --prefix admin run build",
    "dev:admin": "npm --prefix admin run dev",
    "seed": "node api/seed.js",
    "seed:demo": "node api/seed.js --demo",
    "create-admin": "node api/scripts/createAdmin.js",
    "test:e2e": "node tests/e2e.js",
    "test:seo": "node tests/seo-check.js",
    "check": "node --check server.js && node -e \"require('./api/routes');require('./web/router');console.log('syntax ok')\"",
    "test:integrations": "node tests/e2e-integrations.js",
    "migrate": "node api/migrate.js",
    "meta:check": "node api/scripts/metaCheck.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.4",
    "ejs": "^6.0.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.10",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  }
}
